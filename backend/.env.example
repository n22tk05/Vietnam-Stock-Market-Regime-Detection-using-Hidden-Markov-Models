APP_NAME=Astera API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# For Neon, use its connection string with the postgresql+asyncpg scheme.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astera_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-me-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AI_CORE_PATH=../Vietnam-Stock-Market-Regime-Detection-using-Hidden-Markov-Models
AI_CORE_INTEGRATION_MODE=auto
AI_CORE_TIMEOUT_SECONDS=60
AI_CORE_DISABLE_BYTECODE=true

RECOMMENDATION_EXPIRE_HOURS=24
MARKET_REGIME_STALE_HOURS=24
MINIMUM_INVESTMENT_CAPITAL=1000000
INTERNAL_API_TOKEN=

RECOMMENDATION_BULL_CASH_WEIGHT=0.05
RECOMMENDATION_SIDEWAY_CASH_WEIGHT=0.20
RECOMMENDATION_BEAR_CASH_WEIGHT=0.45
RECOMMENDATION_LOW_RISK_MAX_WEIGHT=0.12
RECOMMENDATION_MEDIUM_RISK_MAX_WEIGHT=0.18
RECOMMENDATION_HIGH_RISK_MAX_WEIGHT=0.25
RECOMMENDATION_MIN_DIVERSIFICATION=5

EMAIL_ENABLED=false
EMAIL_FROM=noreply@astera.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
